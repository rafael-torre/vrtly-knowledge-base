{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-project-state.sh",
            "args": ["${CLAUDE_PROJECT_DIR}"],
            "statusMessage": "Scanning project state..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(layers/**/final/**/*.md)|Write(layers/**/final/**/*.md)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/update-metadata.sh",
            "statusMessage": "Updating doc metadata..."
          }
        ]
      }
    ]
  }
}
